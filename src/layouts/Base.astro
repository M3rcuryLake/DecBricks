---
import '../styles/global.css';
import '../styles/decbricks.css';
import { SITE, SITE_URL } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  themeColor?: string;
  robots?: string;
  bodyClass?: string;
  schema?: unknown;
  noindex?: boolean;
}

const {
  title = `${SITE.name} | ${SITE.tagline}`,
  description = SITE.description,
  canonical: canonicalProp,
  ogTitle = title,
  ogDescription = description,
  ogImage = SITE.ogImage,
  themeColor = SITE.themeColor,
  robots: robotsProp,
  bodyClass = 'bg-darkPurple',
  schema,
  noindex = false,
} = Astro.props;

// Canonical derived from the route when a page doesn't pin one explicitly.
// Page-supplied canonicals may be relative (`/about`) or absolute.
const canonical =
  canonicalProp === undefined
    ? new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', SITE_URL).href
    : new URL(canonicalProp, SITE_URL).href;

// Non-production builds are never indexed (set PUBLIC_ENV=production to index).
const isProduction = import.meta.env.PUBLIC_ENV === 'production';
const robots = !isProduction
  ? 'noindex, nofollow'
  : noindex
    ? 'noindex, nofollow'
    : robotsProp ||
      'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION || undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content={themeColor} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="robots" content={robots} />
    <link rel="icon" href="/brand/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/brand/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="preload" as="image" href="/brand/logo-cream.webp" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/bricolage-grotesque-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/hanken-grotesk-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/fk-raster-roman-compact.woff2" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="part-skipLink" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
