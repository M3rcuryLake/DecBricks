---
// TEMPORARY placeholder — the original page imported `astro:content` /
// `../content/config`, which do not exist and broke the build.
// The real Contact page (Cal.com embed, CTA copy, Team, Numbers, form submit)
// is built in Phase 5 per docs/Implementation-plan.md.
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TransitionOverlay from '../components/TransitionOverlay.astro';

const title = 'Contact Decbricks | Start Your Digital Project';
const description =
  'Contact Decbricks for website development, app development, AI automation, custom software, digital marketing and business outreach services.';
---

<Base title={title} description={description} canonical="/contact" bodyClass="bg-darkPurple">
  <div id="__nuxt">
    <main id="main-content" class="layout overflow-hidden bg-darkPurple">
      <Loader />
      <div class="page page-contact bg-darkPurple">
        <Header />
        <div class="relative mx-auto w-full max-w-1920 pt-135 lg:pt-90 xl:pt-115 3xl:pt-150 4xl:pt-170">
          <h1 class="sr-only">Contact Decbricks</h1>
          <p class="mx-14 font-neuePower text-[20px] leading-[1.05] font-bold text-white">
            Contact page under construction.
          </p>
        </div>
        <Footer />
      </div>
      <TransitionOverlay />
    </main>
  </div>
  <script>import '../scripts/main';</script>
</Base>
