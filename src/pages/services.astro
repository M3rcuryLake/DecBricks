---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import ServicesHero from '../components/ServicesHero.astro';
import ServiceBlock from '../components/ServiceBlock.astro';
import ServicesSidebarNav from '../components/ServicesSidebarNav.astro';
import ServicesClients from '../components/ServicesClients.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import TransitionOverlay from '../components/TransitionOverlay.astro';
import { SERVICES, SERVICES_SECTION_HEADER } from '../data/services';
import { servicesPageSchema } from '../lib/schema';

const title = 'Our Expertise & Services | Decbricks';
const description =
  'Explore Decbricks services: strategy & consulting, design & branding, web & software development, mobile apps, AI automation, digital marketing and outreach.';
---

<Base
  title={title}
  description={description}
  canonical="/services"
  ogTitle={title}
  ogDescription={description}
  schema={servicesPageSchema(description)}
  themeColor="#800020"
  bodyClass="bg-darkPurple"
>
  
    <main id="main-content" class="layout overflow-hidden bg-darkPurple">
      <Loader />
      <div class="page page-services bg-white">
        <Header />
        <ServicesHero />
        <section
          data-theme="light"
          class="sections-servicesList relative overflow-hidden bg-darkPurple"
          aria-label="Our services"
        >
          <div
            class="rounded-10 bg-white px-9 pt-10 pb-40 lg:rounded-24 lg:px-20 lg:pt-25 lg:pb-50 xl:px-25 xl:pt-30 xl:pb-60 3xl:px-35 3xl:pt-35 3xl:pb-70 4xl:px-35 4xl:pt-40 4xl:pb-80"
          >
            <div
              class="mx-auto flex w-full max-w-1850 flex-col gap-40 lg:gap-55 xl:gap-65 3xl:gap-80 4xl:gap-95"
            >
              {SERVICES.map((service, index) => <ServiceBlock service={service} index={index} />)}
            </div>
          </div>
        </section>
        <ServicesSidebarNav />
        <ServicesClients />
        <ContactForm smileyCopy={SERVICES_SECTION_HEADER.intro} />
        <Footer />
      </div>
      <CookieBanner />
      <TransitionOverlay />
    </main>
  <script>import '../scripts/main';</script>
</Base>
