---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import HomeLanding from '../components/HomeLanding.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import TransitionOverlay from '../components/TransitionOverlay.astro';
---
<Base
  title="Decbricks | Technology, Creative & Business Growth Agency"
  description="Decbricks partners with ambitious businesses to deliver technology, creative and growth solutions—from software, websites and apps to AI, automation and digital marketing."
>
  
    <main id="main-content" class="layout overflow-hidden bg-darkPurple">
      <Loader />
      <div class="page page-home z-10 bg-white">
        <Header />
        <HomeLanding />
        <Footer />
      </div>
      <CookieBanner />
      <TransitionOverlay />
    </main>
  <script>import '../scripts/main';</script>
</Base>
