---
/**
 * BrandText — render a copy string with every visible "Decbricks" word
 * wrapped in `.font-brand` (FK Raster Roman Compact). Use for paragraphs,
 * bios, CTA copy, legal strings — anything rendered verbatim from data.
 */
import { brandify } from '../lib/brand';

export interface Props {
  text: string;
  /** Optional wrapper element class (content itself stays inline). */
  className?: string;
  /** Markdown-ish paragraphs not needed here: single block only. */
}
const { text, className } = Astro.props;
const html = brandify(text);
---

{className ? (
  <span class={className} set:html={html} />
) : (
  <Fragment set:html={html} />
)}
