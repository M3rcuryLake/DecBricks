---
import { SERVICES, SERVICES_SECTION_HEADER } from '../data/services';
import { brandify } from '../lib/brand';

const HOME_CARD_STYLES = [
  { theme: 't1', isEven: true },
  { theme: 't2', isEven: false },
  { theme: 't3', isEven: true },
  { theme: 't4', isEven: false },
  { theme: 't5', isEven: true },
  { theme: 't6', isEven: false },
  { theme: 't7', isEven: true },
