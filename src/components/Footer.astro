---
import { FOOTER, FOOTER_CONTACT } from '../data/footer';
import FooterCta from './footer/FooterCta.astro';
import FooterNav from './footer/FooterNav.astro';
import FooterContact from './footer/FooterContact.astro';
import FooterStatus from './footer/FooterStatus.astro';
import FooterWordmark from './footer/FooterWordmark.astro';
import FooterLegal from './footer/FooterLegal.astro';
import FooterWebgl from './footer/FooterWebgl.astro';

interface Props {
  cta?: 'auto' | 'show' | 'hide';
}

const { cta = 'auto' } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const showCta = cta === 'show' || (cta === 'auto' && pathname !== '/contact');

const missingDev: string[] = [];
if (import.meta.env.DEV) {
  if (!FOOTER_CONTACT.email) missingDev.push('email (open-items A4)');
  if (FOOTER_CONTACT.phones.length === 0) missingDev.push('phones (open-items A3)');
  if (!FOOTER_CONTACT.cal.link && !FOOTER_CONTACT.cal.bookingUrl) missingDev.push('cal (open-items A2)');
  if (FOOTER_CONTACT.socials.length === 0) missingDev.push('socials (open-items A8)');
  if (FOOTER.legal.every((l) => !l.enabled)) missingDev.push('legal pages /privacy-policy & /terms (open-items A11)');
  if (!FOOTER.studio.timeZone) missingDev.push('studio timezone PUBLIC_STUDIO_TZ');
}
---

<footer
  class="structure-footer relative overflow-hidden"
  role="contentinfo"
  aria-label="Site footer"
  data-dev-missing={import.meta.env.DEV && missingDev.length ? missingDev.join('|') : undefined}
>
  <div class="structure-footer__gridBg" aria-hidden="true"></div>
  <div class="structure-footer__inner relative z-20 overflow-hidden">
    <div class="structure-footer__shell mx-auto flex w-full max-w-1920 flex-col">
      <FooterCta show={showCta} />
      <div class="structure-footer__grid">
        <FooterNav />
        <FooterContact />
        <FooterStatus />
      </div>
      <FooterWordmark />
      <FooterLegal />
    </div>
  </div>
  <div
    class="webgl-background pointer-events-none absolute inset-0 h-full w-full bg-purple"
    data-trail="rgb(188, 61, 77)"
    aria-hidden="true"
  ></div>
</footer>
<FooterWebgl />
