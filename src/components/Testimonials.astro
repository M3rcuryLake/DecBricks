---
/**
 * Home-page testimonials.
 *
 * Phase 0 of docs/plans/testimonials-redesign-plan.md: cards now render from
 * the typed data file `src/data/testimonials.ts` (clearly-marked placeholder
 * set). 1minus1 sticker artwork, the one-off service chip, the pixel-cross
 * "ratings" marks, the minimap chip, the counter chip and the drag-cursor
 * marquee have been removed. The drag-canvas interaction itself is replaced
 * by the spotlight redesign in Phase 1 — until then this section remains
 * interim state.
 */
import { TESTIMONIALS, hasPlaceholderTestimonials } from '../data/testimonials';

const placeholderFlag = import.meta.env.PUBLIC_SHOW_PLACEHOLDER_TESTIMONIALS === 'true';
// Placeholder guard: never ship placeholder social proof as if it were real.
// Dev always previews (with a loud warning); production hides the section
// unless the owner opts in via PUBLIC_SHOW_PLACEHOLDER_TESTIMONIALS=true.
const hideSection = hasPlaceholderTestimonials && !placeholderFlag && import.meta.env.PROD;
if (hasPlaceholderTestimonials && import.meta.env.DEV) {
  console.warn(
    '[testimonials] placeholder quotes are showing. Real, consented quotes must replace them before launch' +
      (placeholderFlag
        ? ' (preview flag PUBLIC_SHOW_PLACEHOLDER_TESTIMONIALS is set — production would still hide this section while placeholders exist).'
        : ' — set PUBLIC_SHOW_PLACEHOLDER_TESTIMONIALS=true to preview them in production builds.')
  );
}

// Short, punchy quotes get the display treatment; longer ones stay body-scale.
const isDisplayQuote = (quote: string) => quote.length <= 100;
---

{
  !hideSection && (
    <section id="testimonials" class="sections-testimonials relative rounded-t-20 bg-darkPurple">
      <div class="relative z-20 mx-auto w-full max-w-1920 px-18 py-32 lg:px-32 lg:py-36">
        <div
          class="sections-testimonials__inner relative z-10 flex aspect-8/11 w-full cursor-none items-center justify-center overflow-hidden rounded-10 bg-sage sm:aspect-square lg:aspect-5/2 lg:min-h-720 lg:rounded-16"
          data-cursor-target
          data-lenis-prevent-touch
        >
          <div class="sections-testimonials__slider relative h-full w-full cursor-none will-change-transform">
            {TESTIMONIALS.map((t, i) => (
              <div
                class={`parts-testimonialCard sections-testimonials__card absolute top-0 left-0 z-10 flex w-360 flex-col items-start origin-center rounded-10 pt-28 pr-18 pb-32 pl-30 will-change-transform lg:w-540 lg:rounded-16 lg:pt-40 lg:pr-48 lg:pb-48 lg:pl-45 ${
                  i % 2 === 0 ? 'bg-white' : 'bg-neonGreen'
                }`}
                data-index={i}
                data-testid={`testimonial-${t.id}`}
              >
                <h3 class={`mb-28 lg:mb-48 ${isDisplayQuote(t.quote) ? 'heading-blockquote' : 'font-nohemi text-[16px] leading-[120%] lg:text-[24px]'}`}>
                  {t.quote}
                </h3>
                <div class="item-center flex flex-col items-start">
                  <span class="subheading text-darkPurple uppercase">{t.name}</span>
                  <span class="subheading text-darkPurple uppercase opacity-70">
                    {t.role}, {t.company}
                  </span>
                </div>
              </div>
            ))}
            <div class="sections-testimonials__border pointer-events-none absolute top-1/2 left-1/2 z-11 -translate-x-1/2 -translate-y-1/2 rounded-8 border-8 border-lightPurple">
              <div class="h-full w-full rounded-12 border-3 border-darkPurple"></div>
            </div>
          </div>
          <div class="sections-testimonials__overlay pointer-events-none absolute inset-0 z-50 h-full w-full cursor-none"></div>
        </div>
      </div>
    </section>
  )
}
