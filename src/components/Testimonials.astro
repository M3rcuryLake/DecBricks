---
/**
 * Home-page testimonials — editorial spotlight (Concept A).
 *
 * Phase 1 of docs/plans/testimonials-redesign-plan.md §8: static spotlight
 * layout. The first card is server-rendered active; prev/next/rail buttons
 * render but are inert until Phase 2 wires the carousel state machine.
 * Styles live in the `tst-*` block of `src/styles/decbricks.css`.
 *
 * Placeholder guard (unchanged from Phase 0): production renders nothing
 * while any `placeholder: true` quote exists, unless the owner opts in via
 * PUBLIC_SHOW_PLACEHOLDER_TESTIMONIALS=true (preview-only).
 */
import { TESTIMONIALS, hasPlaceholderTestimonials } from '../data/testimonials';

const placeholderFlag = import.meta.env.PUBLIC_SHOW_PLACEHOLDER_TESTIMONIALS === 'true';
const hideSection = hasPlaceholderTestimonials && !placeholderFlag && import.meta.env.PROD;
if (hasPlaceholderTestimonials && import.meta.env.DEV) {
  console.warn(
    '[testimonials] placeholder quotes are showing. Real, consented quotes must replace them before launch' +
      (placeholderFlag
        ? ' (preview flag PUBLIC_SHOW_PLACEHOLDER_TESTIMONIALS is set — production would still hide this section while placeholders exist).'
        : ' — set PUBLIC_SHOW_PLACEHOLDER_TESTIMONIALS=true to preview them in production builds.')
  );
}

const total = TESTIMONIALS.length;
const pad2 = (n: number) => String(n).padStart(2, '0');
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase() ?? '')
    .join('');
---

{
  !hideSection && (
    <section
      id="testimonials"
      class="tst-band"
      role="region"
      aria-roledescription="carousel"
      aria-labelledby="testimonials-title"
      data-testid="testimonials"
    >
      <div class="tst-inner">
        <div class="tst-head">
          <div>
            <p class="tst-kicker">
              <em aria-hidden="true">///</em> Social proof
            </p>
            <h2 class="tst-title" id="testimonials-title">
              What our clients say
            </h2>
          </div>
          <p class="tst-index" aria-hidden="true" data-testid="testimonials-index">
            <b>{pad2(1)}</b> / {pad2(total)}
          </p>
        </div>

        <div class="tst-grid">
          <div class="tst-stage" id="testimonials-stage" data-testid="testimonials-stage">
            {TESTIMONIALS.map((t, i) => (
              <article
                class={`tst-card${i === 0 ? ' is-active' : ''}`}
                id={t.id}
                aria-roledescription="quote"
                aria-label={`${i + 1} of ${total}`}
                aria-hidden={i === 0 ? 'false' : 'true'}
                data-testid={`testimonial-${t.id}`}
              >
                <span class="tst-qmark" aria-hidden="true">
                  ///
                </span>
                <blockquote class="tst-quote">
                  <p>{t.quote}</p>
                </blockquote>
                <div class="tst-attr">
                  <span class="tst-dot" aria-hidden="true">
                    {initials(t.name)}
                  </span>
                  <div class="tst-who">
                    <b>{t.name}</b>
                    <span>
                      {t.role}, {t.company}
                    </span>
                  </div>
                  <span class="tst-chip">{t.service}</span>
                </div>
              </article>
            ))}
          </div>

          <nav class="tst-rail" aria-label="All quotes">
            <p class="tst-railTitle">All quotes</p>
            <div class="tst-railList" data-testid="testimonials-rail">
              {TESTIMONIALS.map((t, i) => (
                <button
                  type="button"
                  class={`tst-railBtn${i === 0 ? ' is-active' : ''}`}
                  aria-controls={t.id}
                  aria-current={i === 0 ? 'true' : 'false'}
                  data-testid={`testimonial-rail-${t.id}`}
                >
                  <span class="tst-railQuote">{t.quote}</span>
                  <span class="tst-railMeta">
                    {pad2(i + 1)} · {t.service}
                  </span>
                </button>
              ))}
            </div>
          </nav>
        </div>

        <div class="tst-controls">
          <button type="button" class="tst-btn tst-prev" aria-label="Previous quote" data-testid="testimonials-prev">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.8" />
            </svg>
          </button>
          <button type="button" class="tst-btn tst-next" aria-label="Next quote" data-testid="testimonials-next">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" />
            </svg>
          </button>
          <div class="tst-progress" aria-hidden="true">
            <i class="tst-bar" style={`width: ${100 / total}%`}></i>
          </div>
        </div>
      </div>
    </section>
  )
}
