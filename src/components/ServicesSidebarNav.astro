---
import { SERVICES } from '../data/services';
---

<nav
  class="sections-servicesSidebarNav fixed top-1/2 right-0 z-40 hidden lg:block"
  inert
  aria-label="Services"
>
  <ul class="flex w-58 flex-col gap-4 rounded-l-10 bg-lightPurple px-9 py-9">
    {
      SERVICES.map((service) => (
        <li>
          <a
            href={`#${service.id}`}
            aria-current="false"
            class="sections-servicesSidebarNavItem group flex w-40 flex-col items-center rounded-6 py-15 font-neuePower text-[14px] leading-none font-bold text-darkPurple uppercase transition-colors duration-500 hover:bg-purple hover:text-white aria-[current=true]:bg-purple aria-[current=true]:text-white"
          >
            <div class="flex items-center gap-4">
              <span class="sections-servicesSidebarNavItem__bullet size-3 shrink-0 bg-darkPurple" aria-hidden="true"></span>
              <span class="sections-servicesSidebarNavItem__index">{service.number}</span>
            </div>
            <span class="sections-servicesSidebarNavItem__label block h-0 overflow-hidden">
              <span class="block overflow-hidden pt-15 whitespace-nowrap [text-orientation:sideways] [writing-mode:vertical-rl]">
                <span class="sections-servicesSidebarNavItem__text block">{service.navLabel}</span>
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
