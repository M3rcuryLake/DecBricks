---
import { FOOTER } from '../../data/footer';

const activeColumns = FOOTER.columns
  .map((col) => ({
    ...col,
    links: col.links.filter((link) => link.enabled !== false && Boolean(link.href)),
  }))
  .filter((col) => col.links.length > 0);
---

{
  activeColumns.map((col) => (
    <nav class="structure-footer__col" aria-labelledby={`footer-nav-${col.id}`}>
      <h3 id={`footer-nav-${col.id}`} class="structure-footer__colHeading subheading u-kicker text-darkPurple uppercase">
        {col.heading}
      </h3>
      <ul class="structure-footer__colList">
        {col.links.map((link) => (
          <li>
            <a
              href={link.href}
              class="structure-footer__link text-darkPurple"
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  ))
}
