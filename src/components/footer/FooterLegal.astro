---
import { FOOTER } from '../../data/footer';
import { brandify } from '../../lib/brand';

const legalLinks = FOOTER.legal.filter((l) => l.enabled && Boolean(l.href));
const copyrightHtml = brandify(FOOTER.copyright).replaceAll(
  'class="font-brand"',
  'class="font-brand" translate="no"'
);
---

<div class="structure-footer__legal">
  <p class="structure-footer__copyright subheading u-kicker text-darkPurple uppercase">
    <Fragment set:html={copyrightHtml} />
  </p>

  <div class="structure-footer__legalActions">
    {legalLinks.map((link) => (
      <a
        href={link.href}
        class="structure-footer__legalLink subheading u-kicker text-darkPurple uppercase"
      >
        {link.label}
      </a>
    ))}

    <button
      aria-label={FOOTER.cookieLabel}
      type="button"
      class="parts-btnText structure-footer__legalBtn rounded-sm subheading u-kicker text-darkPurple uppercase focus:outline-none cursor-pointer"
    >
      <span class="relative block overflow-hidden">
        <span class="parts-btnText__label block">{FOOTER.cookieLabel}</span>
        <span class="parts-btnText__label block absolute inset-x-0 top-full" aria-hidden="true">
          {FOOTER.cookieLabel}
        </span>
      </span>
    </button>

    <a
      href={FOOTER.game.href}
      class="structure-footer__legalLink subheading u-kicker text-darkPurple uppercase"
      aria-label={FOOTER.game.label}
    >
      {FOOTER.game.label}
    </a>

    <button class="parts-btnScrollTop structure-footer__topBtn" aria-label="Rise to the top" type="button">
      <span class="relative flex items-center gap-11 overflow-hidden">
        <span class="structure-footer__bricks" data-footer-bricks aria-hidden="true">
          <i class="structure-footer__brick structure-footer__brick--topA" data-brick="6"></i>
          <i class="structure-footer__brick structure-footer__brick--topB" data-brick="5"></i>
          <i class="structure-footer__brick" data-brick="4"></i>
          <i class="structure-footer__brick" data-brick="3"></i>
          <i class="structure-footer__brick" data-brick="2"></i>
          <i class="structure-footer__brick" data-brick="1"></i>
        </span>
        <span class="parts-btnScrollTop__label subheading u-kicker text-darkPurple uppercase" aria-hidden="true">
          Rise to the top
        </span>
        <span
          class="parts-btnScrollTop__label absolute top-full right-0 text-center subheading u-kicker text-darkPurple uppercase"
          aria-hidden="true"
        >
          Rise to the top
        </span>
      </span>
    </button>
  </div>
</div>
