---
import type { ServiceId } from '../data/services';

export interface Props {
  motif: ServiceId;
  code?: string;
  class?: string;
}

const { motif, code, class: className } = Astro.props;

const SURFACE: Record<ServiceId, { bg: string; labelColor: string }> = {
  'strategy-consulting': { bg: '#800020', labelColor: '#F3E6D5' },
  'design-branding': { bg: '#F3E6D5', labelColor: '#800020' },
  'web-software-development': { bg: '#5A0014', labelColor: '#F3E6D5' },
  'mobile-app-development': { bg: '#C9D3C0', labelColor: '#2A0208' },
  'ai-automation': { bg: '#BC3D4D', labelColor: '#FFF9F2' },
  'digital-marketing-growth': { bg: '#5A6432', labelColor: '#FFF9F2' },
  'business-development-outreach': { bg: '#800020', labelColor: '#F3E6D5' },
};

const theme = SURFACE[motif];
---

<div
  class:list={['parts-serviceArtwork relative h-full w-full overflow-hidden select-none', className]}
  style={`background-color: ${theme.bg}; color: ${theme.labelColor};`}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 400 500"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="block h-full w-full"
    preserveAspectRatio="xMidYMid slice"
  >
    {/* Subtle structural border ticks */}
    <rect x="20" y="20" width="8" height="8" fill="currentColor" fill-opacity="0.35" />
    <rect x="372" y="20" width="8" height="8" fill="currentColor" fill-opacity="0.35" />
    <rect x="20" y="472" width="8" height="8" fill="currentColor" fill-opacity="0.35" />
    <rect x="372" y="472" width="8" height="8" fill="currentColor" fill-opacity="0.35" />

    {motif === 'strategy-consulting' && (
      <g>
        {/* 4-quadrant alignment grid */}
        <line x1="200" y1="48" x2="200" y2="432" stroke="#F3E6D5" stroke-opacity="0.22" stroke-width="2" stroke-dasharray="6 6" />
        <line x1="48" y1="240" x2="352" y2="240" stroke="#F3E6D5" stroke-opacity="0.22" stroke-width="2" stroke-dasharray="6 6" />
        <rect x="64" y="88" width="272" height="304" rx="16" stroke="#F3E6D5" stroke-opacity="0.28" stroke-width="2" />
        {/* Stepped cornerstone prism */}
        <rect x="108" y="280" width="184" height="56" rx="6" fill="#5A0014" />
        <rect x="128" y="220" width="144" height="56" rx="6" fill="#F3E6D5" />
        <rect x="152" y="160" width="96" height="56" rx="6" fill="#FFF9F2" />
        <rect class="parts-serviceArtwork__pulse" x="176" y="108" width="48" height="44" rx="6" fill="#D45060" />
        {/* Quadrant pixel coordinates */}
        <rect x="76" y="100" width="20" height="20" fill="#D45060" />
        <rect x="304" y="100" width="20" height="20" fill="#F3E6D5" fill-opacity="0.6" />
        <rect x="76" y="360" width="20" height="20" fill="#F3E6D5" fill-opacity="0.6" />
        <rect x="304" y="360" width="20" height="20" fill="#C9D3C0" />
      </g>
    )}

    {motif === 'design-branding' && (
      <g>
        {/* Modular swatch grid & cropped super-brick emblem */}
        <rect x="52" y="72" width="136" height="136" rx="24" fill="#FFF9F2" />
        <path d="M212 72H348V208H248C228.118 208 212 191.882 212 172V72Z" fill="#800020" />
        <path d="M52 232H260C286.51 232 308 253.49 308 280V344H92C69.9086 344 52 326.091 52 304V232Z" fill="#D45060" />
        <rect class="parts-serviceArtwork__pulse" x="96" y="116" width="48" height="48" rx="12" fill="#800020" />
        <rect x="260" y="120" width="40" height="40" fill="#F3E6D5" />
        {/* Baseline proportion bar */}
        <rect x="52" y="368" width="296" height="24" rx="4" fill="#5A6432" />
        <rect x="68" y="376" width="48" height="8" fill="#FFF9F2" />
        <rect x="132" y="376" width="96" height="8" fill="#F3E6D5" />
        <rect x="244" y="376" width="88" height="8" fill="#C9D3C0" />
      </g>
    )}

    {motif === 'web-software-development' && (
      <g>
        {/* API bus lines */}
        <line x1="60" y1="136" x2="340" y2="136" stroke="#C9D3C0" stroke-opacity="0.35" stroke-width="2" />
        <line x1="60" y1="248" x2="340" y2="248" stroke="#C9D3C0" stroke-opacity="0.35" stroke-width="2" />
        <line x1="60" y1="360" x2="340" y2="360" stroke="#C9D3C0" stroke-opacity="0.35" stroke-width="2" />
        {/* Tiered interlocking architecture stack */}
        <rect x="64" y="96" width="124" height="52" rx="8" fill="#C9D3C0" />
        <rect x="200" y="96" width="136" height="52" rx="8" fill="#5A6432" />
        <rect x="64" y="172" width="196" height="60" rx="8" fill="#FFF9F2" />
        <rect class="parts-serviceArtwork__pulse" x="272" y="172" width="64" height="60" rx="8" fill="#D45060" />
        <rect x="64" y="256" width="96" height="52" rx="8" fill="#800020" stroke="#F3E6D5" stroke-width="2" />
        <rect x="172" y="256" width="164" height="52" rx="8" fill="#C9D3C0" />
        <rect x="64" y="332" width="272" height="56" rx="8" fill="#F3E6D5" />
        {/* Stepped pixel chevron code marks */}
        <rect x="92" y="196" width="12" height="12" fill="#5A0014" />
        <rect x="108" y="184" width="12" height="12" fill="#5A0014" />
        <rect x="108" y="208" width="12" height="12" fill="#5A0014" />
        <rect x="148" y="196" width="76" height="12" fill="#800020" />
      </g>
    )}

    {motif === 'mobile-app-development' && (
      <g>
        {/* Stepped handheld bezel */}
        <rect x="96" y="56" width="208" height="364" rx="28" fill="#800020" />
        <rect x="112" y="76" width="176" height="324" rx="18" fill="#FFF9F2" />
        {/* Speaker notch */}
        <rect x="168" y="88" width="64" height="10" rx="5" fill="#F3E6D5" />
        {/* Modular UI viewport tiles */}
        <rect x="128" y="116" width="144" height="72" rx="10" fill="#5A6432" />
        <rect class="parts-serviceArtwork__pulse" x="144" y="132" width="44" height="40" rx="6" fill="#D45060" />
        <rect x="200" y="136" width="56" height="12" fill="#FFF9F2" />
        <rect x="200" y="156" width="40" height="8" fill="#F3E6D5" />
        <rect x="128" y="204" width="66" height="84" rx="10" fill="#F3E6D5" />
        <rect x="206" y="204" width="66" height="84" rx="10" fill="#C9D3C0" />
        <rect x="128" y="304" width="144" height="56" rx="10" fill="#5A0014" />
        <rect x="144" y="324" width="80" height="14" rx="4" fill="#FFF9F2" />
        {/* Home indicator brick */}
        <rect x="172" y="378" width="56" height="8" rx="4" fill="#800020" />
      </g>
    )}

    {motif === 'ai-automation' && (
      <g>
        {/* Orthogonal DAG conduits */}
        <path d="M200 124V176M200 160H116V208M200 160H284V208M116 268V300H172V336M284 268V300H228V336" stroke="#FFF9F2" stroke-width="4" />
        {/* Root inference brick */}
        <rect x="144" y="68" width="112" height="56" rx="12" fill="#800020" />
        <rect x="164" y="88" width="72" height="16" rx="4" fill="#F3E6D5" />
        {/* Parallel worker bricks */}
        <rect x="64" y="208" width="104" height="60" rx="12" fill="#FFF9F2" />
        <rect x="84" y="228" width="64" height="20" rx="4" fill="#800020" />
        <rect x="232" y="208" width="104" height="60" rx="12" fill="#F3E6D5" />
        <rect x="252" y="228" width="64" height="20" rx="4" fill="#5A0014" />
        {/* Output convergence brick */}
        <rect class="parts-serviceArtwork__pulse" x="120" y="336" width="160" height="64" rx="12" fill="#5A0014" />
        <rect x="144" y="356" width="32" height="24" rx="4" fill="#D45060" />
        <rect x="188" y="362" width="68" height="12" rx="4" fill="#FFF9F2" />
        {/* Joint junction pixels */}
        <rect x="192" y="152" width="16" height="16" fill="#FFF9F2" />
        <rect x="192" y="292" width="16" height="16" fill="#F3E6D5" />
      </g>
    )}

    {motif === 'digital-marketing-growth' && (
      <g>
        {/* Concentric pixel signal arcs */}
        <path d="M268 72H332V136" stroke="#F3E6D5" stroke-opacity="0.45" stroke-width="4" />
        <path d="M236 104H300V168" stroke="#FFF9F2" stroke-opacity="0.7" stroke-width="4" />
        {/* Ascending staircase brick bars */}
        <rect x="60" y="328" width="48" height="72" rx="6" fill="#C9D3C0" />
        <rect x="120" y="280" width="48" height="120" rx="6" fill="#F3E6D5" />
        <rect x="180" y="224" width="48" height="176" rx="6" fill="#FFF9F2" />
        <rect x="240" y="168" width="48" height="232" rx="6" fill="#F3E6D5" />
        <rect x="300" y="112" width="48" height="288" rx="6" fill="#800020" />
        {/* Coral apex target */}
        <rect class="parts-serviceArtwork__pulse" x="300" y="112" width="48" height="48" rx="6" fill="#D45060" />
        {/* Baseline datum */}
        <rect x="48" y="408" width="308" height="8" rx="4" fill="#FFF9F2" />
      </g>
    )}

    {motif === 'business-development-outreach' && (
      <g>
        {/* Twin stepped bridge piers reaching from opposing sides */}
        <rect x="48" y="296" width="84" height="84" rx="10" fill="#5A0014" />
        <rect x="268" y="296" width="84" height="84" rx="10" fill="#5A0014" />
        <rect x="48" y="232" width="116" height="52" rx="8" fill="#F3E6D5" />
        <rect x="236" y="232" width="116" height="52" rx="8" fill="#F3E6D5" />
        <rect x="68" y="168" width="124" height="52" rx="8" fill="#FFF9F2" />
        <rect x="208" y="168" width="124" height="52" rx="8" fill="#FFF9F2" />
        {/* Central interlocking keystone */}
        <rect class="parts-serviceArtwork__pulse" x="156" y="108" width="88" height="76" rx="12" fill="#C9D3C0" />
        <rect x="176" y="128" width="48" height="36" rx="6" fill="#5A6432" />
        <rect x="192" y="138" width="16" height="16" fill="#D45060" />
        {/* Connection baseline */}
        <line x1="48" y1="396" x2="352" y2="396" stroke="#F3E6D5" stroke-opacity="0.35" stroke-width="3" stroke-dasharray="8 8" />
      </g>
    )}
  </svg>

  {code && (
    <span class="parts-serviceArtwork__code">
      {code}
    </span>
  )}
</div>
