---
/**
 * ServiceArtwork — zero-dependency, palette-only generative SVG compositions
 * for Decbricks' 7 core services. Replaces legacy 1minus1 MP4 reels on
 * `/services` (`variant="plate"`, aspect-4/5) and adds a compact geometric
 * discipline emblem on `/` home teaser cards (`variant="mini"`).
 */
import type { ServiceCardTheme, ServiceMotif } from '../data/services';

export interface Props {
  motif: ServiceMotif;
  number: string;
  variant?: 'plate' | 'mini';
  surface?: ServiceCardTheme | 'beige-plate' | 'sage-plate';
  class?: string;
}

const {
  motif,
  number,
  variant = 'plate',
  surface = variant === 'plate' ? 'beige-plate' : 'offwhite',
  class: className = '',
} = Astro.props;
---

<div
  class:list={[
    'parts-serviceArtwork',
    `parts-serviceArtwork--${variant}`,
    className,
  ]}
  data-motif={motif}
  data-surface={surface}
  data-number={number}
  aria-hidden="true"
>
  {variant === 'plate' ? (
    <svg
      viewBox="0 0 320 400"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="parts-serviceArtwork__svg block h-full w-full"
    >
      {/* Subtle architectural drafting frame */}
      <rect x="18" y="18" width="284" height="364" rx="22" stroke="var(--art-ink)" stroke-opacity="0.16" stroke-width="1.5" stroke-dasharray="5 5" />
      <path d="M18 64H302M18 336H302M64 18V382M256 18V382" stroke="var(--art-ink)" stroke-opacity="0.07" stroke-width="1" />
      {/* Corner registration ticks */}
      <path d="M26 38V26H38M282 26H294V38M26 362V374H38M282 374H294V362" stroke="var(--art-accent)" stroke-width="2" />

      {motif === 'blueprint' && (
        <g class="parts-serviceArtwork__scene">
          {/* 01 Strategy & Consulting: Isometric drafting grid, brick foundation & compass target */}
          <rect x="44" y="88" width="232" height="224" rx="14" fill="var(--art-card)" stroke="var(--art-ink)" stroke-opacity="0.2" stroke-width="1.5" />
          <g class="parts-serviceArtwork__brick">
            <rect x="64" y="114" width="90" height="44" rx="6" fill="var(--art-sage)" stroke="var(--art-olive)" stroke-width="1.5" />
            <rect x="164" y="114" width="92" height="44" rx="6" fill="var(--art-accent)" />
            <rect x="64" y="168" width="136" height="44" rx="6" fill="var(--art-ink)" />
            <rect x="210" y="168" width="46" height="44" rx="6" fill="var(--art-card-alt)" stroke="var(--art-ink)" stroke-width="1.5" />
            <rect x="64" y="222" width="60" height="64" rx="6" fill="var(--art-olive)" />
            <rect x="134" y="222" width="122" height="64" rx="6" fill="var(--art-card-alt)" stroke="var(--art-ink)" stroke-opacity="0.25" stroke-width="1.5" />
          </g>
          {/* Compass crosshair overlay */}
          <circle cx="195" cy="254" r="22" stroke="var(--art-ink)" stroke-width="2" stroke-dasharray="4 3" />
          <circle cx="195" cy="254" r="7" fill="var(--art-accent)" />
          <path d="M195 224V284M165 254H225" stroke="var(--art-ink)" stroke-opacity="0.45" stroke-width="1.5" />
        </g>
      )}

      {motif === 'swatches' && (
        <g class="parts-serviceArtwork__scene">
          {/* 02 Design & Branding: Staggered colour specimen plates & pixel anchor cursor */}
          <g class="parts-serviceArtwork__brick">
            <rect x="52" y="110" width="136" height="184" rx="16" fill="var(--art-ink)" />
            <rect x="68" y="126" width="104" height="72" rx="8" fill="var(--art-card-alt)" />
            <rect x="68" y="212" width="48" height="10" rx="3" fill="var(--art-sage)" />
            <rect x="68" y="230" width="78" height="8" rx="3" fill="var(--art-card-alt)" fill-opacity="0.5" />
          </g>
          <g class="parts-serviceArtwork__brick">
            <rect x="128" y="138" width="140" height="176" rx="16" fill="var(--art-card)" stroke="var(--art-ink)" stroke-width="2" />
            <rect x="146" y="156" width="104" height="76" rx="10" fill="var(--art-sage)" />
            <circle cx="198" cy="194" r="22" fill="var(--art-accent)" />
            <rect x="146" y="246" width="30" height="30" rx="6" fill="var(--art-olive)" />
            <rect x="183" y="246" width="30" height="30" rx="6" fill="var(--art-ink)" />
            <rect x="220" y="246" width="30" height="30" rx="6" fill="var(--art-card-alt)" stroke="var(--art-ink)" stroke-width="1.5" />
          </g>
          {/* Pixel cursor badge */}
          <path d="M236 92L244 128L254 118L268 132L275 125L261 111L271 101L236 92Z" fill="var(--art-olive)" stroke="var(--art-card)" stroke-width="2" />
        </g>
      )}

      {motif === 'brackets' && (
        <g class="parts-serviceArtwork__scene">
          {/* 03 Web & Software Development: Layered window frame, pixel braces & stacked API modules */}
          <rect x="44" y="88" width="232" height="224" rx="16" fill="var(--art-ink)" />
          <circle cx="68" cy="110" r="5" fill="var(--art-card-alt)" />
          <circle cx="86" cy="110" r="5" fill="var(--art-accent)" />
          <circle cx="104" cy="110" r="5" fill="var(--art-sage)" />
          <path d="M44 128H276" stroke="var(--art-card)" stroke-opacity="0.2" stroke-width="1.5" />
          {/* Left pixel brace { */}
          <g fill="var(--art-card-alt)" class="parts-serviceArtwork__brick">
            <rect x="74" y="152" width="14" height="10" />
            <rect x="66" y="162" width="10" height="28" />
            <rect x="58" y="190" width="10" height="14" />
            <rect x="66" y="204" width="10" height="28" />
            <rect x="74" y="232" width="14" height="10" />
          </g>
          {/* Right pixel brace } */}
          <g fill="var(--art-sage)" class="parts-serviceArtwork__brick">
            <rect x="232" y="152" width="14" height="10" />
            <rect x="244" y="162" width="10" height="28" />
            <rect x="252" y="190" width="10" height="14" />
            <rect x="244" y="204" width="10" height="28" />
            <rect x="232" y="232" width="14" height="10" />
          </g>
          {/* Inner stacked code bricks */}
          <rect x="108" y="158" width="96" height="16" rx="4" fill="var(--art-accent)" />
          <rect x="108" y="186" width="112" height="16" rx="4" fill="var(--art-card)" />
          <rect x="108" y="214" width="76" height="16" rx="4" fill="var(--art-sage)" />
          <rect x="64" y="264" width="192" height="26" rx="6" fill="var(--art-olive)" />
        </g>
      )}

      {motif === 'device' && (
        <g class="parts-serviceArtwork__scene">
          {/* 04 Mobile App Development: Device chassis, concentric touch waves & modular screen bricks */}
          <rect x="50" y="122" width="220" height="156" rx="16" fill="var(--art-sage)" fill-opacity="0.65" />
          <circle cx="160" cy="200" r="92" stroke="var(--art-ink)" stroke-opacity="0.16" stroke-width="1.5" stroke-dasharray="6 4" />
          <g class="parts-serviceArtwork__brick">
            <rect x="96" y="74" width="128" height="252" rx="22" fill="var(--art-ink)" stroke="var(--art-card)" stroke-width="3" />
            <rect x="108" y="92" width="104" height="202" rx="14" fill="var(--art-card)" />
            {/* Status notch */}
            <rect x="142" y="99" width="36" height="6" rx="3" fill="var(--art-ink)" fill-opacity="0.3" />
            {/* Screen tiles */}
            <rect x="118" y="118" width="84" height="58" rx="8" fill="var(--art-accent)" />
            <rect x="118" y="186" width="38" height="46" rx="8" fill="var(--art-sage)" />
            <rect x="164" y="186" width="38" height="46" rx="8" fill="var(--art-olive)" />
            <rect x="118" y="242" width="84" height="36" rx="8" fill="var(--art-card-alt)" stroke="var(--art-ink)" stroke-opacity="0.25" stroke-width="1.5" />
            {/* Home indicator */}
            <rect x="138" y="308" width="44" height="6" rx="3" fill="var(--art-card)" fill-opacity="0.7" />
          </g>
        </g>
      )}

      {motif === 'nodes' && (
        <g class="parts-serviceArtwork__scene">
          {/* 05 AI & Automation: Neural bus paths, core orchestrator brick & spark nodes */}
          <path d="M84 114L160 200M236 114L160 200M76 200H244M84 286L160 200M236 286L160 200" stroke="var(--art-ink)" stroke-width="2" />
          <rect x="64" y="94" width="40" height="40" rx="8" fill="var(--art-sage)" stroke="var(--art-olive)" stroke-width="2" />
          <rect x="216" y="94" width="40" height="40" rx="8" fill="var(--art-accent)" />
          <rect x="52" y="180" width="40" height="40" rx="8" fill="var(--art-olive)" />
          <rect x="228" y="180" width="40" height="40" rx="8" fill="var(--art-card)" stroke="var(--art-ink)" stroke-width="2" />
          <rect x="64" y="266" width="40" height="40" rx="8" fill="var(--art-accent)" />
          <rect x="216" y="266" width="40" height="40" rx="8" fill="var(--art-sage)" stroke="var(--art-olive)" stroke-width="2" />
          {/* Central core octagon/brick */}
          <g class="parts-serviceArtwork__brick">
            <rect x="122" y="162" width="76" height="76" rx="16" fill="var(--art-ink)" stroke="var(--art-card)" stroke-width="3" />
            <rect x="142" y="182" width="36" height="36" rx="6" fill="var(--art-card)" />
            <rect x="152" y="192" width="16" height="16" fill="var(--art-accent)" />
          </g>
          {/* Pixel spark accents */}
          <rect x="155" y="98" width="10" height="10" fill="var(--art-olive)" />
          <rect x="155" y="292" width="10" height="10" fill="var(--art-olive)" />
        </g>
      )}

      {motif === 'growth' && (
        <g class="parts-serviceArtwork__scene">
          {/* 06 Digital Marketing & Growth: Ascending 5-column brick staircase & trajectory vector */}
          <line x1="48" y1="304" x2="272" y2="304" stroke="var(--art-ink)" stroke-width="2.5" />
          <g class="parts-serviceArtwork__brick">
            <rect x="58" y="246" width="34" height="58" rx="4" fill="var(--art-sage)" stroke="var(--art-olive)" stroke-width="1.5" />
            <rect x="102" y="214" width="34" height="90" rx="4" fill="var(--art-olive)" />
            <rect x="146" y="178" width="34" height="126" rx="4" fill="var(--art-accent)" />
            <rect x="190" y="142" width="34" height="162" rx="4" fill="var(--art-ink)" />
            <rect x="234" y="102" width="34" height="202" rx="4" fill="var(--art-card)" stroke="var(--art-ink)" stroke-width="2" />
          </g>
          {/* Pixel trajectory arrow */}
          <path d="M58 206L114 166L164 148L244 82" stroke="var(--art-accent)" stroke-width="3" stroke-dasharray="6 4" />
          <rect x="238" y="74" width="16" height="16" rx="3" fill="var(--art-accent)" />
        </g>
      )}

      {motif === 'network' && (
        <g class="parts-serviceArtwork__scene">
          {/* 07 Business Development & Outreach: Multi-hub partnership constellation */}
          <path d="M160 124L84 214M160 124L236 214M84 214H236M84 214L160 288M236 214L160 288" stroke="var(--art-ink)" stroke-width="2" />
          {/* Top anchor hub */}
          <rect x="104" y="84" width="112" height="52" rx="12" fill="var(--art-ink)" />
          <rect x="118" y="102" width="52" height="16" rx="4" fill="var(--art-card-alt)" />
          <circle cx="194" cy="110" r="8" fill="var(--art-accent)" />
          {/* Left & Right partner hubs */}
          <g class="parts-serviceArtwork__brick">
            <rect x="44" y="186" width="84" height="52" rx="12" fill="var(--art-olive)" />
            <rect x="58" y="204" width="56" height="14" rx="4" fill="var(--art-card)" />
            <rect x="192" y="186" width="84" height="52" rx="12" fill="var(--art-accent)" />
            <rect x="206" y="204" width="56" height="14" rx="4" fill="var(--art-card)" />
          </g>
          {/* Bottom convergence badge */}
          <rect x="92" y="264" width="136" height="50" rx="12" fill="var(--art-sage)" stroke="var(--art-olive)" stroke-width="2" />
          <rect x="114" y="282" width="92" height="14" rx="4" fill="var(--art-ink)" />
          <circle cx="160" cy="200" r="14" fill="var(--art-card)" stroke="var(--art-ink)" stroke-width="2.5" />
          <rect x="155" y="195" width="10" height="10" fill="var(--art-accent)" />
        </g>
      )}
    </svg>
  ) : (
    <svg
      viewBox="0 0 120 120"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="parts-serviceArtwork__svg block h-full w-full"
    >
      <rect x="8" y="8" width="104" height="104" rx="16" fill="var(--art-mini-bg)" stroke="var(--art-mini-stroke)" stroke-width="2" />

      {motif === 'blueprint' && (
        <g>
          <rect x="22" y="22" width="76" height="76" stroke="var(--art-mini-fg)" stroke-opacity="0.35" stroke-width="1.5" stroke-dasharray="4 4" />
          <rect x="30" y="30" width="26" height="26" rx="4" fill="var(--art-sage)" />
          <rect x="64" y="30" width="26" height="26" rx="4" fill="var(--art-accent)" />
          <rect x="30" y="64" width="60" height="26" rx="4" fill="var(--art-mini-fg)" />
        </g>
      )}

      {motif === 'swatches' && (
        <g>
          <rect x="22" y="26" width="46" height="62" rx="8" fill="var(--art-mini-fg)" />
          <rect x="52" y="34" width="46" height="60" rx="8" fill="var(--art-olive)" stroke="var(--art-mini-bg)" stroke-width="2" />
          <circle cx="75" cy="58" r="11" fill="var(--art-card-alt)" />
        </g>
      )}

      {motif === 'brackets' && (
        <g>
          <rect x="20" y="24" width="80" height="72" rx="10" fill="var(--art-mini-fg)" />
          <rect x="28" y="34" width="64" height="8" rx="3" fill="var(--art-sage)" />
          <rect x="28" y="50" width="28" height="34" rx="4" fill="var(--art-accent)" />
          <rect x="64" y="50" width="28" height="14" rx="4" fill="var(--art-card-alt)" />
          <rect x="64" y="70" width="28" height="14" rx="4" fill="var(--art-olive)" />
        </g>
      )}

      {motif === 'device' && (
        <g>
          <rect x="36" y="18" width="48" height="84" rx="10" fill="var(--art-mini-fg)" />
          <rect x="43" y="26" width="34" height="58" rx="6" fill="var(--art-card-alt)" />
          <rect x="48" y="34" width="24" height="18" rx="3" fill="var(--art-accent)" />
          <rect x="48" y="57" width="24" height="18" rx="3" fill="var(--art-olive)" />
        </g>
      )}

      {motif === 'nodes' && (
        <g>
          <path d="M32 32L88 88M88 32L32 88" stroke="var(--art-mini-fg)" stroke-width="2.5" />
          <rect x="22" y="22" width="20" height="20" rx="5" fill="var(--art-sage)" />
          <rect x="78" y="22" width="20" height="20" rx="5" fill="var(--art-olive)" />
          <rect x="22" y="78" width="20" height="20" rx="5" fill="var(--art-olive)" />
          <rect x="78" y="78" width="20" height="20" rx="5" fill="var(--art-sage)" />
          <rect x="44" y="44" width="32" height="32" rx="8" fill="var(--art-accent)" stroke="var(--art-mini-bg)" stroke-width="2" />
        </g>
      )}

      {motif === 'growth' && (
        <g>
          <rect x="22" y="68" width="14" height="26" rx="3" fill="var(--art-sage)" />
          <rect x="42" y="54" width="14" height="40" rx="3" fill="var(--art-olive)" />
          <rect x="62" y="38" width="14" height="56" rx="3" fill="var(--art-accent)" />
          <rect x="82" y="24" width="14" height="70" rx="3" fill="var(--art-mini-fg)" />
        </g>
      )}

      {motif === 'network' && (
        <g>
          <path d="M36 42H84M36 42L60 80M84 42L60 80" stroke="var(--art-mini-fg)" stroke-width="2.5" />
          <rect x="22" y="28" width="28" height="24" rx="6" fill="var(--art-sage)" />
          <rect x="70" y="28" width="28" height="24" rx="6" fill="var(--art-accent)" />
          <rect x="44" y="68" width="32" height="24" rx="6" fill="var(--art-olive)" />
        </g>
      )}
    </svg>
  )}
</div>
