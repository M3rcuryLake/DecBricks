---
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = pathname === '/';
// Main nav: only pages that exist are linked. Contact gets the highlight pill.
const links = [
  { label: 'Work', href: '/', anchor: '#work', enabled: true, current: isHome },
  { label: 'About', href: '/about', anchor: '', enabled: true, current: pathname === '/about' },
  { label: 'Services', href: '/services', anchor: '', enabled: true, current: pathname === '/services' },
  { label: 'Contact', href: '/contact', anchor: '', enabled: true, current: pathname === '/contact' },
].filter((l) => l.enabled);
---

<header
  class="structure-menu pointer-events-none fixed inset-x-0 top-0 z-110 flex w-full items-center px-16 pt-17 lg:px-40 lg:pt-26"
  ><a
    aria-current={isHome ? 'page' : undefined}
    href="/"
    class:list={[
      isHome && 'router-link-active router-link-exact-active',
      'parts-animatedLogo relative z-10 mr-auto rounded-8 px-12 py-10 transition-all duration-500 lg:px-18 lg:py-16 text-white pointer-events-auto',
    ]}
    aria-label="Decbricks — Go to homepage"
    ><div class="relative"
      ><span
        class="font-brand structure-menu__logo block origin-left transition-colors duration-300 whitespace-nowrap text-[22px] lg:text-[26px]"
      >
        Decbricks
      </span></div></a
  ><nav
    class="pointer-events-auto hidden items-center gap-5 overflow-hidden rounded-8 structure-navPill p-4 lg:flex"
    aria-label="Main navigation"
  >{links.map((link, i) => (
      <a
        aria-current={link.current ? 'page' : undefined}
        href={link.href}
        data-anchor={link.anchor || undefined}
        class:list={[
          link.current && 'router-link-active router-link-exact-active',
          link.label === 'Contact'
            ? 'parts-btnBlock flex items-center bg-darkPurple duration-500 focus:outline-none rounded-8 px-8 pt-9 pb-8 lg:py-14 lg:px-16 hover:bg-white hover:text-darkPurple'
            : 'parts-btnBlock flex items-center text-darkPurple duration-500 focus:outline-none hover:bg-white focus:bg-white rounded-8 px-8 pt-9 pb-8 lg:py-14 lg:px-16',
        ]}
        aria-label={link.label}
      ><span class="parts-btnBlock__index" aria-hidden="true">{`0${i + 1}`}</span
        ><div class="relative flex overflow-hidden"
        ><span class="parts-btnBlock__label text-center btn-text uppercase">{link.label}</span
        ><span class="parts-btnBlock__label absolute inset-x-0 top-full text-center btn-text uppercase">{link.label}</span></div
      ></a>
    )) }</nav
  ><button
    class="pointer-events-auto flex items-center justify-center gap-9 rounded-8 border-2 border-white/70 bg-white/70 py-10 pr-10 pl-14 btn-text text-darkPurple uppercase backdrop-blur-xl lg:hidden"
    aria-expanded="false"
  >
    Menu
    <svg
      class="svgs-doubleSlash -mt-2 block w-17 min-w-17"
      viewBox="0 0 18 10"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <rect x="8" y="9.27246" width="3.09091" height="3.09091" transform="rotate(-90 8 9.27246)" fill="currentColor" />
      <rect
        x="11.0938"
        y="6.18066"
        width="3.09091"
        height="3.09091"
        transform="rotate(-90 11.0938 6.18066)"
        fill="currentColor"
      />
      <rect
        x="14.1797"
        y="3.09082"
        width="3.09091"
        height="3.09091"
        transform="rotate(-90 14.1797 3.09082)"
        fill="currentColor"
      />
      <rect y="9.27246" width="3.09091" height="3.09091" transform="rotate(-90 0 9.27246)" fill="currentColor" />
      <rect
        x="3.09375"
        y="6.18066"
        width="3.09091"
        height="3.09091"
        transform="rotate(-90 3.09375 6.18066)"
        fill="currentColor"
      />
      <rect
        x="6.17969"
        y="3.09082"
        width="3.09091"
        height="3.09091"
        transform="rotate(-90 6.17969 3.09082)"
        fill="currentColor"
      /></svg></button
  ><nav
    class="pointer-events-auto absolute inset-x-0 top-0 flex w-full flex-col px-17 pt-100 pb-27 lg:hidden"
    aria-label="Main navigation"
    ><div class="relative z-10 overflow-hidden"
      >{links.map((link, i) => (
        <a
          aria-current={link.current ? 'page' : undefined}
          href={link.href}
          data-anchor={link.anchor || undefined}
          class:list={[
            link.current && 'router-link-active router-link-exact-active',
            'link block btn-menu text-darkPurple uppercase',
          ]}
          aria-label={link.label}
        ><span class="link-index" aria-hidden="true">{`0${i + 1}`}</span>{link.label}</a
        >
      ))}
    </div
    ><div class="structure-menu__meta relative z-10 mt-auto flex items-center justify-between pt-24"
      ><span class="u-kicker">Menu</span
      ><span class="u-kicker">Esc to close</span
    ></div
    ><button
      class="close absolute top-16 right-16 z-10 flex items-center gap-8 rounded-8 bg-darkPurple text-white px-13 py-11 btn-text uppercase"
      aria-expanded="false"
      aria-label="Close navigation menu"
    >
      Close
      <svg
        class="svgs-cross block w-9 min-w-9"
        viewBox="0 0 12 12"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <rect x="4" y="8" width="4" height="4" transform="rotate(-90 4 8)" fill="currentColor" />
        <rect x="8" y="4" width="4" height="4" transform="rotate(-90 8 4)" fill="currentColor" />
        <rect y="4" width="4" height="4" transform="rotate(-90 0 4)" fill="currentColor" />
        <rect y="12" width="4" height="4" transform="rotate(-90 0 12)" fill="currentColor" />
        <rect x="8" y="12" width="4" height="4" transform="rotate(-90 8 12)" fill="currentColor" /></svg></button
    ><div
      class="background absolute inset-x-0 top-0 bottom-0 w-full"
      aria-hidden="true"
    ></div></nav
></header>